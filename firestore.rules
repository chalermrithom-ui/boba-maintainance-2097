rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if caller is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Get user document to inspect role
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    
    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.role == 'admin' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && getUserData().role == 'admin')
      );
    }
    
    function isTechnician() {
      return isAuthenticated() && (
        request.auth.token.role == 'technician' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && getUserData().role == 'technician')
      );
    }

    function isViewer() {
      return isAuthenticated() && (
        request.auth.token.role == 'viewer' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && getUserData().role == 'viewer')
      );
    }

    // Check if user is assigned to this specific ticket
    function isAssignedTechnician(ticketData) {
      return isTechnician() && (
        ticketData.assignedTechnicianId == request.auth.uid ||
        ticketData.assignedTechnician == getUserData().name ||
        ticketData.assignedTechnicianPhone == getUserData().phone
      );
    }

    // 1. Users collection
    match /users/{userId} {
      // Admin can manage all users
      allow read, write: if isAdmin();
      // Users can read and update their own profile (avatar, preferredLanguage, password update)
      allow read: if isAuthenticated() && (request.auth.uid == userId || isViewer());
      allow update: if isAuthenticated() && request.auth.uid == userId;
    }

    // 2. Tickets collection
    match /tickets/{ticketId} {
      // Admin has full access
      allow read, write: if isAdmin();

      // Technician: can read and update tickets assigned to them
      allow read: if isAssignedTechnician(resource.data);
      allow update: if isAssignedTechnician(resource.data) && (
        // Technicians can update status, checklist, images, comments, expenses
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['jobNumber', 'customerId', 'createdBy'])
      );

      // Viewer: can read according to permissions
      allow read: if isViewer();

      // Guest: can read and update specific fields if valid share token matches
      // (Used when guest submits acceptance, ratings, or report issue)
      allow read: if true; // Public access filtered by shareToken lookup in app layer
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'customerAcceptance', 'status', 'warranty', 'activityLogs', 'comments', 'followUpTicketIds', 'updatedAt'
      ]);
    }

    // 3. Quotations collection
    match /quotations/{quotationId} {
      // Admin has full access
      allow read, write: if isAdmin();

      // Viewer can read if permitted
      allow read: if isViewer();

      // Technician can read quotations for tickets assigned to them
      allow read: if isTechnician();
      allow create, update: if isTechnician();

      // Guest can read and approve/request revision for their specific quotation
      allow read: if true;
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'status', 'notes', 'versionHistory', 'updatedAt'
      ]);
    }

    // 4. Share Links collection (Guest Access Control)
    match /shareLinks/{linkId} {
      // Admin can create, modify, deactivate, regenerate share links
      allow read, write: if isAdmin();
      
      // Guest can read token and increment viewCount
      allow read: if true;
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'viewCount', 'lastViewedAt'
      ]);
    }

    // 5. Guest Approvals collection
    match /guestApprovals/{approvalId} {
      allow read: if isAdmin() || isViewer();
      allow create: if true; // Guests submit approval records
    }

    // 6. Payments collection
    match /payments/{paymentId} {
      allow read, write: if isAdmin();
      allow read: if isViewer();
      // Guest can attach payment slip
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'slipUrl', 'status', 'paidAt', 'referenceNo', 'notes'
      ]);
    }

    // 7. Company Settings & System Config
    match /companySettings/{docId} {
      allow read: if true; // Brand details for guest portal
      allow write: if isAdmin();
    }

    // 8. Notifications collection
    match /notifications/{notifId} {
      allow read, write: if isAuthenticated();
    }

    // 9. Activity Logs / Audit Trails
    match /activityLogs/{logId} {
      allow read: if isAdmin() || isViewer();
      // Both internal staff and guest portals can record audit logs
      allow create: if true;
    }
  }
}
